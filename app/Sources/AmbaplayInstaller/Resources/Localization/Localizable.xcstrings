    "Check your installation" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l'installazione"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查安装状态"
          }
        }
      }
    },
    "Checking the latest release and the application on this Mac." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo l'ultima versione e l'applicazione su questo Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在检查最新版本以及这台 Mac 上的应用程序。"
          }
        }
      }
    },
    "Close Ambaplay before updating. Steam setup and any required permissions are handled by Ambaplay after installation." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi Ambaplay prima di aggiornare. Dopo l'installazione, Ambaplay configurerà Steam e richiederà le autorizzazioni necessarie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新前请先退出 Ambaplay。安装后，Ambaplay 会配置 Steam 并请求所需权限。"
          }
        }
      }
    },
    "Copying Apple's graphics, the engine and settings" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia della grafica di Apple, del motore e delle impostazioni"
