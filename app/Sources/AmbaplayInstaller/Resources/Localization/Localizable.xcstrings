    "Review the details below, then try again. The installer does not remove your game data." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla i dettagli qui sotto e riprova. Il programma di installazione non rimuove i dati di gioco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请查看下方详情后重试。安装器不会删除你的游戏数据。"
          }
        }
