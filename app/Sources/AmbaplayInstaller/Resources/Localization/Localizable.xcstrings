    "Installing Steam, Apple's graphics, the engine and the default settings. Please keep the installer open." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installazione di Steam, della grafica di Apple, del motore e delle impostazioni predefinite. Tieni aperto il programma di installazione."
