{
  "sourceLanguage" : "en",
  "strings" : {
    "A newer Ambaplay build is already installed. It has been kept." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A newer Ambaplay build is already installed. It has been kept."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già installata una build più recente di Ambaplay. È stata mantenuta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装更新的 Ambaplay 构建版本，现有版本已保留。"
          }
        }
      }
    },
    "Another application already uses the install location. Move it in Finder before trying again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another application already uses the install location. Move it in Finder before trying again."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra applicazione occupa già il percorso di installazione. Spostala nel Finder prima di riprovare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装位置已有其他应用。请在访达中将其移走后重试。"
          }
        }
      }
    },
    "Another installation is in progress, or the installer lock cannot be accessed. Try again after it finishes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another installation is in progress, or the installer lock cannot be accessed. Try again after it finishes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso un’altra installazione o non è possibile accedere al blocco del programma di installazione. Riprova al termine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个安装正在进行，或无法访问安装锁。请在安装结束后重试。"
          }
        }
      }
    },
    "Apple's Game Porting Toolkit and Ambaplay's graphics layers, checked against Ambaplay's signature. Setup adds the WineCX engine later." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Game Porting Toolkit di Apple e i livelli grafici di Ambaplay, verificati con la firma di Ambaplay. Più avanti Setup aggiunge il motore WineCX."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 的 Game Porting Toolkit 和 Ambaplay 的图形层，已用 Ambaplay 的签名校验。设置稍后会添加 WineCX 引擎。"
          }
        }
      }
    },
    "Ambaplay Installer" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installatore Ambaplay"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Program Installer Ambaplay"
          }
        }
      }
    },
    "Ambaplay is installed, but Steam, Apple's graphics or the engine could not be set up. Try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay è installato, ma non è stato possibile configurare Steam, la grafica di Apple o il motore. Riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay 已安装，但无法设置 Steam、Apple 图形组件或引擎。请重试。"
          }
        }
      }
    },
    "Ambaplay is installed. You can eject the installer and move its DMG to Trash in Finder." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay è installato. Puoi espellere il programma di installazione e spostare il DMG nel Cestino dal Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay 已安装。你可以在 Finder 中推出安装器并将 DMG 移到废纸篓。"
          }
        }
      }
    },
    "Ambaplay is ready" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay è pronto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay 已就绪"
          }
        }
      }
    },
    "Ambaplay is up to date" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay è aggiornato"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambaplay 已是最新版本"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Check" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查"
          }
        }
